{
	"name": "riftboundfaq",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm rules:generate && pnpm cards:generate && pnpm build:app",
		"build:app": "next build",
		"cards:extract": "jq -f scripts/cards/extract.jq sources/card-gallery-data.json > sources/card-catalog.json && oxfmt sources/card-catalog.json && pnpm cards:generate",
		"cards:generate": "tsx scripts/cards/generate-index.ts",
		"dev": "next dev",
		"start": "next start",
		"types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
		"postinstall": "pnpm cards:generate && fumadocs-mdx",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:github": "oxlint --format=github --deny-warnings",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"rules:generate": "tsx scripts/generate-rules.ts && fumadocs-mdx",
		"rules:inspect": "tsx scripts/inspect-rules.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@floating-ui/react-dom": "2.1.9",
		"@radix-ui/react-collapsible": "1.2.1",
		"@t3-oss/env-nextjs": "0.13.11",
		"@vercel/analytics": "2.0.1",
		"class-variance-authority": "0.7.1",
		"cnfast": "0.2.0",
		"fumadocs-core": "16.17.8",
		"fumadocs-mdx": "15.4.10",
		"fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
		"lucide-react": "1.62.0",
		"next": "16.4.3",
		"posthog-node": "5.57.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"takumi-js": "2.18.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "25.9.9",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/browser-playwright": "5.0.5",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"pdfjs-dist": "6.4.299",
		"postcss": "8.5.32",
		"remark-mdx": "3.1.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"vitest-browser-react": "2.3.0"
	},
	"packageManager": "pnpm@12.16.1"
}
